generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
  CAREGIVER
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String
  role              Role               @default(PATIENT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  devices           Device[]
  alerts            Alert[]
  emergencyContacts EmergencyContact[]
  dailyMetrics      DailyMetric[]
  journalEntries    JournalEntry[]
}

model Device {
  id         String      @id @default(cuid())
  deviceId   String      @unique
  name       String?
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  ecgRecords EcgRecord[]
  alerts     Alert[]
}

model EcgRecord {
  id           String    @id @default(cuid())
  deviceId     String
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  timestamp    DateTime
  samplingRate Int       @default(250)

  lead1        Json
  lead2        Json
  lead3        Json

  heartRate    Int?
  hrv          Float?
  createdAt    DateTime  @default(now())

  alerts       Alert[]
}

model EmergencyContact {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  relation       String?
  phone          String?
  email          String?
  telegramChatId String?
  priority       Int      @default(1)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Alert {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId     String
  device       Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  ecgRecordId  String?
  ecgRecord    EcgRecord?    @relation(fields: [ecgRecordId], references: [id], onDelete: SetNull)

  type         AlertType
  severity     AlertSeverity
  message      String
  acknowledged Boolean       @default(false)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum AlertType {
  HIGH_HEART_RATE
  LOW_HEART_RATE
  LOW_HRV
  IRREGULAR_RHYTHM
  SIGNAL_LOSS
  DEVICE_OFFLINE
  GENERAL_RISK
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// =========================================================
// Added for the Risk & Trends and Cardiac Diary pages.
// Nothing above this line was changed.
// =========================================================

/// One row per user per calendar day — the rollup the Risk and Diary
/// pages read from. Kept up to date incrementally by ecgController's
/// ingestEcg (see the "roll into today's DailyMetric" step there), and
/// backfilled with realistic history by prisma/seed.js for demo purposes.
model DailyMetric {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date            DateTime // normalized to local midnight — one record per user/day

  restingHr       Int?     // BPM
  hrv             Float?   // RMSSD, ms
  rhythmStability Float?   // 0-100 %
  riskScore       Int?     // 0-100, computed by services/riskScoreService.js
  wornMinutes     Int?     // minutes the device was worn that day
  activityLevel   Float?   // arbitrary 0-100 index
  sleepHr         Int?     // average overnight HR, BPM

  // Cached AI narratives (Gemini via services/aiService.js) so we don't
  // regenerate on every page load.
  aiDiaryText     String?  @db.Text
  aiRiskText      String?  @db.Text

  // Chart data for the Diary page.
  heartRateSeries Json?    // [{ hour, minute, bpm }, ...]
  rrIntervals     Json?    // [[rrN, rrN+1], ...] pairs for the Poincaré plot

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  journalEntries  JournalEntry[]

  @@unique([userId, date])
  @@index([userId, date])
}

/// User-entered or system-logged items for the Diary page's "Events
/// Timeline" and "Notes" — the real backing store for the check-in /
/// medication / symptom buttons already on DashboardPage (not yet wired
/// up there — this model is ready whenever you connect them).
model JournalEntry {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  dailyMetricId String?
  dailyMetric   DailyMetric? @relation(fields: [dailyMetricId], references: [id], onDelete: SetNull)

  occurredAt    DateTime
  type          JournalType
  text          String

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, occurredAt])
}

enum JournalType {
  CHECK_IN
  MEDICATION
  SYMPTOM
  NOTE
  AI_SUMMARY
}